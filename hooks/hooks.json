{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "bash ./scripts/post_tool_use.sh",
        "matcher": "Read|Grep|Glob|WebSearch|WebFetch|mcp__.+__(read|grep|glob|search|fetch).*",
        "timeout": 1
      }
    ],
    "preCompact": [
      {
        "command": "bash ./scripts/pre_compact.sh",
        "timeout": 5
      }
    ]
  }
}
