{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "bash ./scripts/pre_tool_use.sh",
        "matcher": "Shell|Read|Grep|Glob|WebSearch|WebFetch|Task",
        "timeout": 3
      }
    ],
    "postToolUse": [
      {
        "command": "bash ./scripts/post_tool_use.sh",
        "matcher": "Shell|Read|Grep|Glob|WebSearch|WebFetch|Task",
        "timeout": 3
      },
      {
        "command": "bash ./agent/run_critic.sh",
        "matcher": "Write|Edit|ApplyPatch|MultiEdit|NotebookEdit",
        "timeout": 15,
        "failClosed": false
      }
    ]
  }
}
